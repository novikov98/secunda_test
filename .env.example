# Уровень логов приложения: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# --- API ---
# Статический ключ, который клиент передаёт в заголовке X-API-Key.
API_KEY=local-dev-api-key
API_TITLE=Payments processing service
API_HOST=0.0.0.0
API_PORT=8000

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=payments
POSTGRES_PASSWORD=payments
POSTGRES_DB=payments
POSTGRES_ECHO=false

# --- RabbitMQ ---
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
# После стольких неудачных попыток сообщение уходит в payments.dlq.
RABBITMQ_MAX_DELIVERY_ATTEMPTS=3
RABBITMQ_RETRY_BASE_DELAY_SECONDS=5.0

# --- Outbox relay ---
OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_INTERVAL_SECONDS=1.0

# --- Webhook ---
WEBHOOK_TIMEOUT_SECONDS=10.0
WEBHOOK_MAX_ATTEMPTS=3
WEBHOOK_RETRY_BASE_DELAY_SECONDS=1.0

# --- Эмуляция платёжного шлюза ---
GATEWAY_MIN_DELAY_SECONDS=2.0
GATEWAY_MAX_DELAY_SECONDS=5.0
GATEWAY_SUCCESS_RATE=0.9
